{
  "name": "dsh-cmd-enter-send",
  "version": "0.1.0",
  "private": true,
  "description": "Cmd+Enter sends the message and Enter inserts a newline in the DeepSeek Harness composer.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ay27/dsh-cmd-enter-send.git"
  },
  "homepage": "https://github.com/ay27/dsh-cmd-enter-send",
  "bugs": {
    "url": "https://github.com/ay27/dsh-cmd-enter-send/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "composer",
    "keyboard"
  ],
  "license": "MIT"
}
